# 1. Išjungiame katalogų failų sąrašų atvaizdavimą (Saugumo reikalavimas)
Options -Indexes

# 2. Įjungiame URL perrašymo modulį
RewriteEngine On

# 3. Leidžiame tiesiogiai pasiekti realiai egzistuojančius failus ir katalogus
# (Tai būtina, kad veiktų jūsų CSS, JS, paveikslėliai ir kiti "assets" failai)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 4. Visas kitas užklausas nukreipiame į index.php
# Nuorodos dalis po domeno perduodama į 'route' GET parametrą.
# QSA (Query String Append) išsaugo ir kitus GET parametrus, jei tokių yra.
# L (Last) nurodo, kad tai paskutinė perrašymo taisyklė.
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]