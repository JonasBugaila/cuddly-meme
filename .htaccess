# Išjungiame katalogų naršymą
Options -Indexes

# Apsauga nuo tiesioginės prieigos prie jautrių failų
<FilesMatch "\.(php\.bak|env|sql|txt|json|md|log|ini|sh|bak|backup|kopija)$">
    # Palaikymas senesnei Apache 2.2
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
    # Palaikymas naujai Apache 2.4+
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Blokavimas konfigūracijos ir jautrių aplankų iš išorės
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/(.*)$ - [F,L]
    RewriteRule ^vendor/(.*)$ - [F,L]
    RewriteRule ^includes/(.*)$ - [F,L]
</IfModule>


# logs/.htaccess
Require all denied